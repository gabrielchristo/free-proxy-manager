# Application
DATABASE_URL=sqlite:///./data/proxies.db
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Checker
CHECKER_CONCURRENCY=50
CHECK_TIMEOUT=5
CHECK_URL=https://www.google.com/

# Jobs (seconds)
COLLECT_INTERVAL=900
RECHECK_INTERVAL=300
CLEANUP_INTERVAL=3600
SCORE_INTERVAL=300

# Cooldown
FAILURE_THRESHOLD=3
COOLDOWN_INITIAL=300
COOLDOWN_MAX=7200

# Pool
POOL_MIN_SCORE=10

# ProxyScrape source
PROXYSCRAPE_ENABLED=true
PROXYSCRAPE_URL=https://cdn.jsdelivr.net/gh/proxyscrape/free-proxy-list@main/proxies/all/data.json
PROXYSCRAPE_PRIORITY=100
