# Application
APP_NAME=free-proxy-manager
DATABASE_URL=sqlite:///./data/proxies.db
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
LOG_COLOR_ENABLED=true
API_HOST=0.0.0.0
API_PORT=9321
SOURCES_CONFIG_PATH=./sources.json

# Checker
CHECKER_CONCURRENCY=6
CHECKER_QUEUE_MAX_SIZE=100
CHECKER_ENQUEUE_BATCH_SIZE=100
CHECKER_REFILL_INTERVAL=5
CHECKER_SELECTION_POOL_SIZE=500
CHECKER_TRANSPORT_POOL_SIZE=64
CHECK_TIMEOUT=5
# Resposta ~8 bytes ("success"). Alternativa zero-body: http://connectivitycheck.gstatic.com/generate_204
CHECK_URL=http://detectportal.firefox.com/success.txt
CHECK_ALLOWED_HOSTS=detectportal.firefox.com
CHECK_ALLOWED_SCHEMES=http,https
CHECK_SUCCESS_STATUS_MIN=200
CHECK_SUCCESS_STATUS_MAX=399
CHECK_FOLLOW_REDIRECTS=true
CONNECTIVITY_CHECK_ENABLED=true
CONNECTIVITY_CHECK_INTERVAL=30

# Jobs (seconds)
COLLECT_INTERVAL=900
COLLECTOR_RUN_ON_STARTUP=true
COLLECTOR_PERSIST_BATCH_SIZE=250
RECHECK_INTERVAL=300
CLEANUP_INTERVAL=3600
SCORE_INTERVAL=300
STATS_SNAPSHOT_INTERVAL=300
STATS_SNAPSHOT_RETENTION_DAYS=30
STATS_HISTORY_MAX_HOURS=720
STATS_HISTORY_MAX_LIMIT=8640
RECHECK_BATCH_SIZE=100
SCORE_BATCH_SIZE=150

# Cooldown
FAILURE_THRESHOLD=3
COOLDOWN_INITIAL=300
COOLDOWN_MAX=7200
COOLDOWN_MAX_LEVEL=5

# Pool
POOL_MIN_SCORE=10
POOL_TOP_CANDIDATES=25
POOL_SELECTION_MIN_WEIGHT=1

# API
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100
API_MAX_SCORE=100

# Cleanup
CLEANUP_STALE_DAYS=7

# Database pool (SQLite: keep small — one writer, few concurrent readers)
DB_POOL_SIZE=1
DB_POOL_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_SQLITE_TIMEOUT=30
# WAL ~100KB target: SQLite page ~4KB, 25 pages ≈ 100KB autocheckpoint threshold
DB_WAL_AUTOCHECKPOINT=25
DB_CHECKPOINT_ON_COMMIT=false
DB_CHECKPOINT_COMMIT_MODE=PASSIVE
DB_CHECKPOINT_INTERVAL=120
DB_CHECKPOINT_INTERVAL_MODE=TRUNCATE

# Filters
ANONYMOUS_EXCLUDE_VALUE=transparent

# Scorer
SCORER_SUCCESS_WEIGHT=40
SCORER_LATENCY_MAX=40
SCORER_LATENCY_DIVISOR=50
SCORER_RECENCY_MAX=20
SCORER_FAILURE_PENALTY=10
SCORER_HISTORY_CAP=20
SCORER_SCORE_MAX=100
SCORER_HTTPS_BONUS=10
SCORER_HTTPS_PROTOCOL=https
SCORER_MULTI_SOURCE_BONUS=8
SCORER_ANONYMITY_BONUS=transparent=0,anonymous=6,elite=12,high_anonymous=12

# Docker Compose (optional)
DOCKER_MEMORY_LIMIT=512m
DOCKER_HEALTHCHECK_INTERVAL=30s
DOCKER_HEALTHCHECK_TIMEOUT=5s
DOCKER_HEALTHCHECK_RETRIES=3
DOCKER_HEALTHCHECK_START_PERIOD=60s
